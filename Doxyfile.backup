# Doxyfile 1.9.8

# This file describes the settings to be used by the documentation system
# doxygen (www.doxygen.org) for a project.
#
# All text after a double hash (##) is considered a comment and is placed in
# front of the TAG it is preceding.
#
# All text after a single hash (#) is considered a comment and will be ignored.
# The format is:
# TAG = value [value, ...]
# For lists, items can additionally be appended using:
# TAG += value [value, ...]
# Values that contain spaces should be placed between quotes (" ")

#---------------------------------------------------------------------------
# Project related configuration options
#---------------------------------------------------------------------------

# This tag specifies the encoding of the character symbols in the source files.
# UTF-8 is assumed. Doxygen uses this information when generating CHM style
# binary output. In front-end configurations, doxygen attempts to guess the
# encoding. When publishing to other systems, it's best to specify the
# encoding explicitly.
# The default value is: UTF-8.

DOXYFILE_ENCODING      = UTF-8

# The PROJECT_NAME tag is a single word (or a sequence of words surrounded by
# double-quotes, unless you are using Doxywizard) that should identify the
# project for which the documentation is generated. This name is used in the
# title of most generated pages and in a few other places.
# The default value is: My Project.

PROJECT_NAME           = "PubBTQuant Trading Engine"

# The PROJECT_NUMBER tag can be used to enter a project or revision number.
# This could be handy for archiving the generated documentation at a specific
# point in time of a project development cycle.
# To use this feature just insert something like "version 2.3.1" or "2003-04-15"
# The default value is: 

PROJECT_NUMBER         = 1.0

# Using the PROJECT_BRIEF tag one can provide an optional one line description
# for the project.
# This is shown on the main page (index.html).
# To use this feature just insert something like "An example of using doxygen"
# This tag requires that the tag HAVE_DOT is set to YES.

PROJECT_BRIEF          = "Advanced Trading Terminal with Volume Analysis and Real-time Data Processing"

# With the PROJECT_LOGO tag you can specify an image or icon which is included
# in the documentation. The maximum height of the logo should not exceed 55
# pixels and the maximum width should not exceed 200 pixels. Doxygen will copy
# the logo to the output directory.

PROJECT_LOGO           = 

# The OUTPUT_DIRECTORY tag is used to specify the (relative or absolute) path
# into which the generated documentation will be written.
# If a relative path is entered, it will be relative to the location where
# doxygen was started. If left blank the current directory will be used.

OUTPUT_DIRECTORY       = docs/api_reference

# If the CREATE_SUBDIRS tag is set to YES, then doxygen will create 4096 sub-
# directories (in 2 levels) under the output directory of doxygen. If enabled,
# the directories are organized in a 2-level hierarchy which can improve the
# browsing experience on some web servers, but it can also be useful when
# using doxygen to generate output for RTFM (Rich Text Format Manual) systems
# where a limit of 512 files per directory is imposed.
# The default value is: NO.

CREATE_SUBDIRS         = NO

# If the ALLOW_UNICODE_NAMES tag is set to YES, doxygen will allow non-ASCII
# characters to appear in the names of generated files. If set to NO, non-ASCII
# characters will be escaped as "&#xA9;" (where 0xA9 is the Unicode hex code
# for the copyright symbol &copy; for example). This option is automatically
# enabled for QBX output.
# The default value is: NO.

ALLOW_UNICODE_NAMES    = NO

# The OUTPUT_LANGUAGE tag is used to specify the language in which all
# documentation generated by doxygen is written. Doxygen will use this
# information to generate all constant output in the proper language.
# Possible values are: Afrikaans, Arabic, Armenian, Brazilian, Bulgarian, Catalan, Chinese, Chinese-Traditional, Croatian, Czech, Danish, Dutch, English, Esperanto, Finnish, French, German, Greek, Hungarian, Indonesian, Italian, Japanese, Japanese-en (Japanese with English messages), Korean, Korean-en (Korean with English messages), Latvian, Lithuanian, Macedonian, Norwegian, Persian, Polish, Portuguese, Romanian, Russian, Serbian, Serbian-Cyrillic, Slovak, Slovene, Spanish, Swedish, Turkish, Ukrainian and Vietnamese.
# The default value is: English.

OUTPUT_LANGUAGE        = English

# If the BRIEF_MEMBER_DESC tag is set to YES, doxygen will include brief member
# descriptions after the members that are listed in the file and class
# documentation (similar to Javadoc). Set to NO to disable this.
# The default value is: YES.

BRIEF_MEMBER_DESC      = YES

# If the REPEAT_BRIEF tag is set to YES, doxygen will prepend the brief
# description of a member or function before the detailed description.
# Note: If both HIDE_UNDOC_MEMBERS and BRIEF_MEMBER_DESC are set to NO, the
# brief descriptions will be completely suppressed.
# The default value is: YES.

REPEAT_BRIEF           = YES

# This tag implements a quasi-intelligent brief description abbreviator that is
# used to form the text in various listings. Each string in this list, if found
# as the leading text of the brief description, will be stripped from the text
# and the result, after processing the whole list, is used as the annotated
# text. Otherwise, the brief description is used as-is. If left blank, the
# following values are used ($name is automatically replaced with a proper
# name): "The $name class" "The $name widget" "The $name file" "is" "provides"
# "specifies" "contains" "represents" "a" "an" "the"

ABBREVIATE_BRIEF       = "The $name class" \
                         "The $name widget" \
                         "The $name file" \
                         is \
                         provides \
                         specifies \
                         contains \
                         represents \
                         a \
                         an \
                         the

# If the ALWAYS_DETAILED_SEC and REPEAT_BRIEF tags are both set to YES then
# doxygen will generate a detailed section for each member not only for the
# first occurrence but for all occurrences. If set to NO, only the first
# occurrence of a member will have a detailed section.
# The default value is: NO.

ALWAYS_DETAILED_SEC    = NO

# If the INLINE_INHERITED_MEMB tag is set to YES, doxygen will show all
# inherited members of a class in the documentation of that class as if those
# members were ordinary class members. Constructors, destructors and assignment
# operators of the base classes will not be shown.
# The default value is: NO.

INLINE_INHERITED_MEMB  = NO

# If the FULL_PATH_NAMES tag is set to YES, doxygen will prepend the full path
# before files name in the file list and in the header files. If set to NO the
# shortest path that makes the file name unique will be used.
# The default value is: NO.

FULL_PATH_NAMES        = NO

# The STRIP_FROM_PATH tag can be used to strip a user-defined part of the path.
# Stripping is only done if one of the specified strings matches the left-hand
# part of the path. The tag can be used to show relative paths in the file list.
# If left blank the directory from which doxygen is run is used as the path to
# strip.

STRIP_FROM_PATH        = 

# The STRIP_FROM_INC_PATH tag can be used to strip a user-defined part of the
# path mentioned in the documentation of a class, which tells the reader which
# header file to include in order to use a class. If left blank only the name of
# the header file containing the class definition is used. Otherwise one should
# specify the list of include paths that are normally passed to the compiler
# using the -I flag.

STRIP_FROM_INC_PATH    = 

# If the SHORT_NAMES tag is set to YES, doxygen will generate much shorter (but
# less readable) file names. This can be useful is case of very deep
# directories.
# The default value is: NO.

SHORT_NAMES            = NO

# If the JAVADOC_AUTOBRIEF tag is set to YES then doxygen will interpret the
# first line (until the first dot) of a Javadoc-style comment as the brief
# description. If set to NO, the Javadoc-style will behave just like regular Qt-
# style comments (thus requiring an explicit @brief command for a brief
# description.)
# The default value is: NO.

JAVADOC_AUTOBRIEF      = YES

# If the JAVADOC_BANNER tag is set to YES then doxygen will interpret a line
# such as
# /***************
#  * A Class   *
#  ***************/
# as a brief description (if there is no detailed description) and will
# subsequently discard the line.
# The default value is: NO.

JAVADOC_BANNER         = NO

# If the QT_AUTOBRIEF tag is set to YES then doxygen will interpret the first
# line (until the first dot) of a Qt-style comment as the brief description. If
# set to NO, the Qt-style will behave just like regular Qt-style comments (thus
# requiring an explicit \brief command for a brief description.)
# The default value is: NO.

QT_AUTOBRIEF           = NO

# The MULTILINE_CPP_IS_BRIEF tag can be set to YES to make doxygen treat a
# multi-line C++ special comment block (i.e. a block of //! or /// comments) as
# a brief description. This used to be the default behavior. The new default is
# to treat a multi-line C++ comment block as a detailed description. Set this
# tag to YES if you prefer the old behavior instead.
# 
# Note that this new behavior is more in line with general C++ coding standards
# as these mandate that the first sentence of a member documentation block is
# the brief description.
# The default value is: NO.

MULTILINE_CPP_IS_BRIEF = NO

# If the INHERIT_DOCS tag is set to YES then an undocumented member inherits
# the documentation from any documented member that it re-implements.
# The default value is: YES.

INHERIT_DOCS           = YES

# If the SEPARATE_MEMBER_PAGES tag is set to YES then doxygen will produce a new
# page for each member. If set to NO, the documentation of a member will be part
# of the file/class/namespace that contains it.
# The default value is: NO.

SEPARATE_MEMBER_PAGES  = NO

# The TAB_SIZE tag can be used to set the number of spaces in a tab. Doxygen
# uses this value to replace tabs by spaces in code fragments.
# Minimum value: 1, maximum value: 16, default value: 4.

TAB_SIZE               = 4

# This tag can be used to specify a number of aliases that act as macros in the
# documentation. An alias has the form:
# name=value
# For example adding
# SRCPATH=$srcpath
# will allow you to use the command \link $SRCPATH/subdir/file.cpp \endlink
# The property name gets expanded to value in the documentation.
# To put a literal equals sign inside the value, use $$.

ALIASES                = 

# Set the OPTIMIZE_OUTPUT_FOR_C tag to YES if your project consists of C sources
# only. Doxygen will then generate output that is more tailored for C. For
# instance, some of the names that are used will be different. The list of all
# members will be omitted, etc.
# The default value is: NO.

OPTIMIZE_OUTPUT_FOR_C  = NO

# Set the OPTIMIZE_OUTPUT_JAVA tag to YES if your project consists of Java or
# Python sources only. Doxygen will then generate output that is more tailored
# for that language. For instance, namespaces will be presented as packages,
# qualified scopes will look different, etc.
# The default value is: NO.

OPTIMIZE_OUTPUT_JAVA   = NO

# Set the OPTIMIZE_FOR_FORTRAN tag to YES if your project consists of Fortran
# sources. Doxygen will then generate output that is tailored for Fortran.
# The default value is: NO.

OPTIMIZE_FOR_FORTRAN   = NO

# Set the OPTIMIZE_OUTPUT_VHDL tag to YES if your project consists of VHDL
# sources. Doxygen will then generate output that is tailored for VHDL.
# The default value is: NO.

OPTIMIZE_OUTPUT_VHDL   = NO

# Set the OPTIMIZE_OUTPUT_SLICE tag to YES if your project consists of Slice
# sources only. Doxygen will then generate output that is more tailored for that
# language. For instance, namespaces will be presented as modules, types will be
# separated into more groups, etc.
# The default value is: NO.

OPTIMIZE_OUTPUT_SLICE  = NO

# Doxygen selects the parser to use depending on the extension of the files it
# parses. With this tag you can assign which parser to use for a given
# extension. Doxygen has a built-in mapping, but you can override or extend it
# using this tag. The format is ext=language, where ext is a file extension, and
# language is one of the parsers supported by doxygen: IDL, Java, JavaScript,
# Csharp, C, C++, Lex, Objective-C, Python, D, PHP, Fortran, VHDL, Swift, Go,
# QML, Slice, HTML, UCFS, Pascal. For instance to make doxygen treat .inc files
# as Fortran files (for legacy Fortran code), use inc=Fortran. For C/C++ source
# files you can use c,cc,cpp,cxx,h,hpp,hxx,inl,ino,idl,ddl,f,for,ftn,fpp files.
# The default directory extensions mappings are:
# .c=.c, .C=.cpp, .cc=.cpp, .cpp=.cpp, .cxx=.cpp, .ecpp=.cpp, .c++=.cpp,
# .inl=.cpp, .h=.h, .hh=.h, .hpp=.h, .hxx=.h, .ipp=.cpp, .ii=.cpp, .ixx=.cpp,
# .inl=.cpp, .i++=.cpp, .idl=.idl, .ddl=.idl, .odl=.idl, .h++=.h, .C++.cpp,
# .c++.cpp, .i=.c, .ii=.cpp, .ixx=.cpp, .idl=.idl, .ddl=.idl, .odl=.idl,
# .ipf=.fortran, .def=.IDL, .hp=.h, .as=.as, .js=.javascript, .java=.java,
# .cs=.csharp, .d=.d, .php=.php, .php4=.php, .php5=.php, .phtml=.php, .p=.pascal,
# .pas=.pascal, .PAS=.pascal, .m=.objective-c, .mm=.objective-c++, .M=.objc++,
# .mii=.objc++, .MII=.objc++, .py=.python, .pyw=.python, .f=.fortran, .for=.fortran,
# .ftn=.fortran, .fpp=.fortran, .vhd=.vhdl, .vhdl=.vhdl, .swift=.swift, .go=.go,
# .qml=.qml, .qbs=.qml, .sbl=.UCFS, .lsp=.Lisp, .lisp=.Lisp, .scm=.Scheme,
# .sch=.Scheme, .R=.R, .md=.md, .markdown=.md, .sql=.SQL, .pl=.Perl, .pm=.Perl,
# .pod=.Perl, .t=.Perl, .sh=.Shell, .bat=.Shell, .rc=.RC, .vb=.VB, .bas=.VB,
# .frm=.VB, .cls=.VB, .ctl=.VB, .resx=.RC, .ds=.D, .def=.IDL, .ini=.INI,
# .cfg=.INI, .txt=.TXT, .xl=.Lex, .x=.Lex, .y=.Yacc, .yy=.Yacc, .spy=.Python,
# .pyi=.Python, .ps=.PostScript, .json=.JSON, .toml=.TOML, .yaml=.YAML,
# .yml=.YAML, .xml=.XML, .svg=.SVG, .html=.HTML, .htm=.HTML, .shtml=.HTML,
# .xhtml=.HTML, .xht=.HTML, .rss=.XML, .atom=.XML, .xmi=.XML, .wsdl=.XML,
# .xsd=.XML, .dtd=.XML, .svgz=.SVG, .png=.PNG, .jpg=.JPEG, .jpeg=.JPEG,
# .gif=.GIF, .bmp=.BMP, .ico=.ICO, .tif=.TIFF, .tiff=.TIFF, .eps=.EPS,
# .pdf=.PDF, .psd=.PSD, .ai=.AI, .ps=.PostScript, .epsi=.EPS, .epsf=.EPS,
# .dot=.DOT, .fig=.FIG, .dia=.DIA, .uml=.UML, .plantuml=.PLANTUML,
# .puml=.PLANTUML, .iuml=.UML, .m4=.M4, .mak=.MAK, .mk=.MK, .am=.AM,
# .in=.IN, .ac=.AC, .cmake=.CMAKE, .cmake.in=.CMAKE, .pc=.PC, .pc.in=.PC,
# .spec=.SPEC, .desktop=.DESKTOP, .service=.SERVICE, .rules=.RULES,
# .rules.in=.RULES, .po=.PO, .pot=.POT, .potx=.POT, .potm=.POT, .pps=.PPS,
# .ppsx=.PPSX, .ppsm=.PPSM, .ppt=.PPT, .pptx=.PPTX, .pptm=.PPTM,
# .xls=.XLS, .xlsx=.XLSX, .xlsm=.XLSM, .xlt=.XLT, .xltx=.XLTX, .xltm=.XLT,
# .csv=.CSV, .tsv=.TSV, .ods=.ODS, .odt=.ODT, .ott=.OTT, .rtf=.RTF,
# .doc=.DOC, .docx=.DOCX, .docm=.DOCM, .dot=.DOT, .dotx=.DOTX, .dotm=.DOTM,
# .pdf=.PDF, .djvu=.DJVU, .djv=.DJVU, .epub=.EPUB, .mobi=.MOBI,
# .azw=.AZW, .azw3=.AZW3, .fb2=.FB2, .lit=.LIT, .lrf=.LRF, .pdb=.PDB,
# .prc=.PRC, .oxps=.OXPS, .xps=.XPS, .cbz=.CBZ, .cbr=.CBR, .cb7=.CB7,
# .cba=.CBA, .cbt=.CBT, .ibooks=.IBOOKS, .opf=.OPF, .ncx=.NCX, .opf2=.OPF,
# .ncx2=.NCX, .opf3=.OPF, .ncx3=.NCX, .opf4=.OPF, .ncx4=.NCX, .opf5=.OPF,
# .ncx5=.NCX, .opf6=.OPF, .ncx6=.NCX, .opf7=.OPF, .ncx7=.NCX, .opf8=.OPF,
# .ncx8=.NCX, .opf9=.OPF, .ncx9=.NCX, .opf10=.OPF, .ncx10=.NCX, .opf11=.OPF,
# .ncx11=.NCX, .opf12=.OPF, .ncx12=.NCX, .opf13=.OPF, .ncx13=.NCX, .opf14=.OPF,
# .ncx14=.NCX, .opf15=.OPF, .ncx15=.NCX, .opf16=.OPF, .ncx16=.NCX, .opf17=.OPF,
# .ncx17=.NCX, .opf18=.OPF, .ncx18=.NCX, .opf19=.OPF, .ncx19=.NCX, .opf20=.OPF,
# .ncx20=.NCX, .opf21=.OPF, .ncx21=.NCX, .opf22=.OPF, .ncx22=.NCX, .opf23=.OPF,
# .ncx23=.NCX, .opf24=.OPF, .ncx24=.NCX, .opf25=.OPF, .ncx25=.NCX, .opf26=.OPF,
# .ncx26=.NCX, .opf27=.OPF, .ncx27=.NCX, .opf28=.OPF, .ncx28=.NCX, .opf29=.OPF,
# .ncx29=.NCX, .opf30=.OPF, .ncx30=.NCX, .opf31=.OPF, .ncx31=.NCX, .opf32=.OPF,
# .ncx32=.NCX, .opf33=.OPF, .ncx33=.NCX, .opf34=.OPF, .ncx34=.NCX, .opf35=.OPF,
# .ncx35=.NCX, .opf36=.OPF, .ncx36=.NCX, .opf37=.OPF, .ncx37=.NCX, .opf38=.OPF,
# .ncx38=.NCX, .opf39=.OPF, .ncx39=.NCX, .opf40=.OPF, .ncx40=.NCX, .opf41=.OPF,
# .ncx41=.NCX, .opf42=.OPF, .ncx42=.NCX, .opf43=.OPF, .ncx43=.NCX, .opf44=.OPF,
# .ncx44=.NCX, .opf45=.OPF, .ncx45=.NCX, .opf46=.OPF, .ncx46=.NCX, .opf47=.OPF,
# .ncx47=.NCX, .opf48=.OPF, .ncx48=.NCX, .opf49=.OPF, .ncx49=.NCX, .opf50=.OPF,
# .ncx50=.NCX, .opf51=.OPF, .ncx51=.NCX, .opf52=.OPF, .ncx52=.NCX, .opf53=.OPF,
# .ncx53=.NCX, .opf54=.OPF, .ncx54=.NCX, .opf55=.OPF, .ncx55=.NCX, .opf56=.OPF,
# .ncx56=.NCX, .opf57=.OPF, .ncx57=.NCX, .opf58=.OPF, .ncx58=.NCX, .opf59=.OPF,
# .ncx59=.NCX, .opf60=.OPF, .ncx60=.NCX, .opf61=.OPF, .ncx61=.NCX, .opf62=.OPF,
# .ncx62=.NCX, .opf63=.OPF, .ncx63=.NCX, .opf64=.OPF, .ncx64=.NCX, .opf65=.OPF,
# .ncx65=.NCX, .opf66=.OPF, .ncx66=.NCX, .opf67=.OPF, .ncx67=.NCX, .opf68=.OPF,
# .ncx68=.NCX, .opf69=.OPF, .ncx69=.NCX, .opf70=.OPF, .ncx70=.NCX, .opf71=.OPF,
# .ncx71=.NCX, .opf72=.OPF, .ncx72=.NCX, .opf73=.OPF, .ncx73=.NCX, .opf74=.OPF,
# .ncx74=.NCX, .opf75=.OPF, .ncx75=.NCX, .opf76=.OPF, .ncx76=.NCX, .opf77=.OPF,
# .ncx77=.NCX, .opf78=.OPF, .ncx78=.NCX, .opf79=.OPF, .ncx79=.NCX, .opf80=.OPF,
# .ncx80=.NCX, .opf81=.OPF, .ncx81=.NCX, .opf82=.OPF, .ncx82=.NCX, .opf83=.OPF,
# .ncx83=.NCX, .opf84=.OPF, .ncx84=.NCX, .opf85=.OPF, .ncx85=.NCX, .opf86=.OPF,
# .ncx86=.NCX, .opf87=.OPF, .ncx87=.NCX, .opf88=.OPF, .ncx88=.NCX, .opf89=.OPF,
# .ncx89=.NCX, .opf90=.OPF, .ncx90=.NCX, .opf91=.OPF, .ncx91=.NCX, .opf92=.OPF,
# .ncx92=.NCX, .opf93=.OPF, .ncx93=.NCX, .opf94=.OPF, .ncx94=.NCX, .opf95=.OPF,
# .ncx95=.NCX, .opf96=.OPF, .ncx96=.NCX, .opf97=.OPF, .ncx97=.NCX, .opf98=.OPF,
# .ncx98=.NCX, .opf99=.OPF, .ncx99=.NCX, .opf100=.OPF, .ncx100=.NCX

EXTENSION_MAPPING      = 

# If the SEARCHENGINE tag is set to NO, doxygen will not generate a search
# engine for the HTML output. The default search engine that comes with
# doxygen is a simple text-based search engine that searches for all specified
# keywords. See also CUSTOM_SEARCH_ENGINE_URL tag for enabling the use of an
# external search engine.
# The default value is: YES.

SEARCHENGINE           = YES

# The SERVER_BASED_SEARCH tag sets whether a JavaScript-based search engine
# should be used, which searches the generated HTML documentation as you type.
# If the tag is set to NO, the search engine will search for all words as you
# type. If the tag is set to YES, it will search for all words that you type,
# except for the words defined in the STOPWORDS tag.
# The default value is: NO.

SERVER_BASED_SEARCH    = NO

# When the EXTERNAL_SEARCH tag is enabled doxygen will generate a search index
# that can be used by an external search engine. Doxygen will not generate
# JavaScript based search code nor a search form in the HTML output.
# The default value is: NO.

EXTERNAL_SEARCH        = NO

# The HTML_FORMULA_FORMAT tag determines the format to use for LaTeX formulas in
# HTML output. Possible values are png, svg, and html. If you set the value to
# svg, then you need to set the HTML_MATH_INLINE tag to YES or NO depending on
# whether you want to use MathJax or not. If you set the value to html, then
# formulas will be typeset by the browser using MathML.
# The default value is: png.

HTML_FORMULA_FORMAT    = png

#---------------------------------------------------------------------------
# Build related configuration options
#---------------------------------------------------------------------------

# If the ENABLE_PREPROCESSING tag is set to YES, doxygen will evaluate all
# C-preprocessor directives found in the sources and include files.
# The default value is: YES.

ENABLE_PREPROCESSING   = YES

# Set the MACRO_EXPANSION tag to YES to enable macro expansion within code
# snippets in the documentation. Note that this feature is still experimental
# and incomplete at the moment.
# The default value is: NO.

MACRO_EXPANSION        = NO

# When the EXPAND_ONLY_PREDEF tag is set to YES doxygen will only expand
# macros that are defined in the PREDEFINED or EXPAND_AS_DEFINED tags and not
# other macros found in the sources.
# The default value is: NO.

EXPAND_ONLY_PREDEF     = NO

# If the SEARCH_INCLUDES tag is set to YES, the include files in the
# INCLUDE_PATH will be searched if a #include is found.
# The default value is: YES.

SEARCH_INCLUDES        = YES

# The INCLUDE_PATH tag can be used to specify one or more directories that
# contain include files that are not input files but should be processed by
# the preprocessor.
# This tag requires that the tag ENABLE_PREPROCESSING is set to YES.

INCLUDE_PATH           = dependencies/BTQ_Render_Engine/include

# You can use the INCLUDE_FILE_PATTERNS tag to specify one or more wildcard
# patterns (like *.h and *.hpp) to filter out the header-files in the
# directories. If left blank, the patterns specified with FILE_PATTERNS will be
# used.

INCLUDE_FILE_PATTERNS  = *.h \
                         *.hpp

# The PREDEFINED tag can be used to specify one or more macro names that are
# defined before the preprocessor starts on the input to replace them with zero
# or more arguments. The argument list is checked for correct expressions and
# is passed to the preprocessor as a replacement. The preprocessor output is
# still parsed, but all the macro definitions inside the block are only
# considered when preprocessing is done. Macro expansion is not available if
# the grouping of statements is too complex.

PREDEFINED             = 

# If the EXPAND_AS_DEFINED tag is set to YES, doxygen will also expand macros
# that are inside an #undef statement. Set to NO if you want to disable this
# feature.
# The default value is: NO.

EXPAND_AS_DEFINED      = NO

# If the SKIP_FUNCTION_MACROS tag is set to YES then doxygen's preprocessor
# will remove all references to function-like macros that are alone on a line,
# have an all uppercase name, and do not end with a semicolon. Such function
# macros are typically used for boiler-plate code, and will confuse the parser.
# The default value is: YES.

SKIP_FUNCTION_MACROS   = YES

#---------------------------------------------------------------------------
# Configuration options related to warning and progress messages
#---------------------------------------------------------------------------

# The QUIET tag can be used to turn on/off the messages that are generated to
# standard output by doxygen. If QUIET is set to YES this implies that
# WARNINGS and WARN_IF_UNDOCUMENTED are set to NO as well.
# The default value is: NO.

QUIET                  = NO

# The WARNINGS tag can be used to turn on/off the warning messages that are
# generated to standard error (stderr) by doxygen. If WARNINGS is set to NO
# all warnings will be turned off.
# The default value is: YES.

WARNINGS               = YES

# If the WARN_IF_UNDOCUMENTED tag is set to YES then doxygen will generate
# warnings for undocumented members. If EXTRACT_ALL is set to YES, then this flag
# will automatically be disabled.
# The default value is: YES.

WARN_IF_UNDOCUMENTED   = YES

# If the WARN_IF_DOC_ERROR tag is set to YES, doxygen will generate warnings for
# potential errors in the documentation, such as not documenting some parameters
# in a documented function, or documenting parameters that don't exist or using
# markup commands wrongly.
# The default value is: YES.

WARN_IF_DOC_ERROR      = YES

# This WARN_NO_PARAMDOC option can be enabled to get warnings for functions that
# are documented, but have no documentation for their parameters or return
# value. If set to NO, doxygen will only warn about wrong parameter
# documentation.
# The default value is: YES.

WARN_NO_PARAMDOC       = YES

# If the WARN_AS_ERROR tag is set to YES then doxygen will immediately stop when
# a warning is hit. If the tag is set to FAIL_ON_WARNINGS YES, doxygen will
# stop at the end of the parsing phase if there were any warnings. If the tag
# is set to NO, warnings are reported but doxygen continues.
# Possible values are: NO, YES and FAIL_ON_WARNINGS.
# The default value is: NO.

WARN_AS_ERROR          = NO

# The SUPPRESS_WARNINGS tag can be used to suppress certain warnings. Multiple
# warnings can be suppressed by defining them in the following way:
# SUPPRESS_WARNINGS = warning1 warning2 warning3
# The warning strings are case-insensitive and accept * as wildcard character.

SUPPRESS_WARNINGS      = 

# The WARN_FORMAT tag determines the format of the warning messages that doxygen
# can generate. The string should contain the $file, $line, and $text tags,
# which will be replaced by the file and line number from which the warning
# originated and the warning text. Optionally the format may contain $version,
# $function, $component and $progress tags, which will be replaced by the
# version of doxygen, the name of the function in which the warning occurred,
# the component to which the warning belongs to and the progress reference of
# the component to which the warning belongs to.
# See also: WARN_LOGFILE
# The default value is: $file:$line: $text

WARN_FORMAT            = "$file:$line: $text"

# The WARN_LOGFILE tag can be used to specify a file to which warning and error
# messages should be written. If left blank the output is written to standard
# error (stderr).

WARN_LOGFILE           = 

#---------------------------------------------------------------------------
# Configuration options related to the input files
#---------------------------------------------------------------------------

# The INPUT tag is used to specify the files and/or directories that contain
# documented source files. Wildcards are allowed. See also FILE_PATTERNS and
# EXTENSION_MAPPING. The documentation is explained in the section "Input" in
# the manual.

INPUT                  = . \
                         dependencies/BTQ_Render_Engine/include \
                         Examples \
                         hotspine \
                         Installers \
                         autonomous_agency

# This tag can be used to specify the character encoding of the source files
# that doxygen parses. Internally doxygen uses the UTF-8 encoding. Doxygen uses
# libiconv (or the iconv built into libc) for the transcoding. See the libiconv
# documentation for the list of possible encodings.
# The default value is: UTF-8.

INPUT_ENCODING         = UTF-8

# If the value of the INPUT tag contains directories, you can use the
# FILE_PATTERNS tag to specify one or more wildcard patterns (like *.cpp and
# *.h) to filter out the source-files in the directories.
# 
# Note that for custom extensions or not directly supported extensions you also
# need to set EXTENSION_MAPPING for the extension otherwise the files are not
# properly processed by doxygen.
# 
# If left blank the following patterns are tested:*.c, *.cc, *.cxx, *.cpp,
# *.c++, *.java, *.ii, *.ixx, *.ipp, *.i++, *.inl, *.idl, *.ddl, *.odl, *.h, *.hh,
# *.hxx, *.hpp, *.h++, *.l, *.cs, *.d, *.php, *.php4, *.php5, *.phtml, *.inc,
# *.m, *.markdown, *.md, *.mm, *.dox (to be provided as doxygen C comment),
# *.py, *.pyw, *.f90, *.f95, *.f03, *.f08, *.f18, *.f, *.for, *.ftn, *.fpp,
# *.s, *.asm, *.sv, *.svh, *.vhd, *.vhdl, *.ucf, *.qsf and *.ice.

FILE_PATTERNS          = *.c \
                         *.cc \
                         *.cxx \
                         *.cpp \
                         *.c++ \
                         *.java \
                         *.ii \
                         *.ixx \
                         *.ipp \
                         *.i++ \
                         *.inl \
                         *.idl \
                         *.ddl \
                         *.ods \
                         *.h \
                         *.hh \
                         *.hxx \
                         *.h++ \
                         *.hpp \
                         *.lib \
                         *.api \
                         *.td \
                         *.d \
                         *.OC \
                         *.PC \
                         *.def \
                         *.cs \
                         *.D \
                         *.sw \
                         *.vhd \
                         *.vhdl \
                         *.py \
                         *.pyw \
                         *.f90 \
                         *.f95 \
                         *.f03 \
                         *.f08 \
                         *.f18 \
                         *.f \
                         *.for \
                         *.ftn \
                         *.fpp \
                         *.s \
                         *.asm \
                         *.sv \
                         *.svh \
                         *.ucf \
                         *.qsf \
                         *.ice \
                         *.md \
                         *.markdown \
                         *.txt \
                         *.rst \
                         *.dox

# The RECURSIVE tag can be used to specify whether or not subdirectories should
# be searched for input files as well.
# The default value is: NO.

RECURSIVE              = YES

# The EXCLUDE tag can be used to specify files and/or directories that should be
# excluded from the INPUT source files. This way you can easily exclude a
# subdirectory from a directory tree whose root is specified with the INPUT tag.
# 
# Note that relative paths are relative to the directory containing the Doxyfile
# (not the directory specified with INPUT).

EXCLUDE                =

# The EXCLUDE_SYMLINKS tag can be used to select whether or not files or
# directories that are symbolic links (a Unix file system feature) are excluded
# from the input.
# The default value is: NO.

EXCLUDE_SYMLINKS       = NO

# If the value of the INPUT tag contains directories, you can use the
# EXCLUDE_PATTERNS tag to specify one or more wildcard patterns to exclude
# certain files from those directories.
# 
# Note that the wildcards are matched against the file with absolute path, so to
# exclude all test directories for example use the pattern */test/*

EXCLUDE_PATTERNS       = 

# The EXCLUDE_SYMBOLS tag can be used to specify one or more symbol names
# (namespaces, classes, functions, etc.) that should be excluded from the
# output. The symbol name can be a fully qualified name, a word, or if the
# wildcard * is used, a substring. Examples: ANamespace, AClass,
