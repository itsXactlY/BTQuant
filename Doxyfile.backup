# generated to the HTML output directory that can be used for the Eclipse help
# system.
# The default value is: NO.

GENERATE_ECLIPSEHELP   = NO

# A unique identifier for the Eclipse help plugin. When installing the plugin
# the directory name of the Eclipse plugin is derived from this tag. So it
# should be unique and not contain spaces or special characters like :, +, *,
