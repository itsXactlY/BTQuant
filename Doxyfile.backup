# The DOT_NODE_ATTR tag can be used to set the attributes for the dot tool's
# nodes in order to reduce the generated amount of dot file content.
# The default value is: fontname=Helvetica,fontsize=10.
# This tag requires that the tag HAVE_DOT is set to YES.

DOT_NODE_ATTR          = "fontname=Helvetica,fontsize=10"

