# 
# The HTML Help Workshop contains a compiler that can process the generated
# index.hhp, index.hhc and index.hhk files and combine them into a single
# compiled HTML file (.chm) that can be distributed.
# The default value is: NO.

GENERATE_HTMLHELP      = NO

# The CHM_FILE tag can be used to specify the file name of the resulting .chm
