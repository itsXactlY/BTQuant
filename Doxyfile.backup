# generate the images on the fly by invoking the htmlform and dvipng tools.
# See also: HTML_FORMULA_FORMAT

HTML_FORMULA_FILE        = 

# Use this tag to change the font size of LaTeX formulas included as images in
# the HTML documentation. The default value is: 10. Note that the font size is
# passed as an argument to the htmlform and dvipng tools when generating the
# formula images. If the FORMULA_FILE tag is not specified, the default file
# used is latex/formula.form.
# Minimum value: 8, maximum value: 50, default value: 10.

FORMULA_FONTSIZE       = 10

# Use the FORMULA_TRANSPARENT tag to determine the transparency of the images
