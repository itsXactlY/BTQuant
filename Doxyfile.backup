# preprocessing chain.

HTML_EXTRA_FILES       = 

# The HTML_COLORSTYLE tag can be used to specify if the generated HTML output
# should be rendered with a dark or light theme.
# Possible values are: LIGHT always generates light output, DARK always generates
# dark output, AUTO_LIGHT automatically uses light output unless the user
# prefers dark output, AUTO_DARK automatically uses dark output unless the user
# prefers light output and AUTO is an alias for AUTO_LIGHT.
# The default value is: AUTO.

HTML_COLORSTYLE        = AUTO

# In the HTML_COLORSTYLE_HUE tag the color of the HTML output can be influenced
# by specifying a hue value. The value is given in degrees on the color wheel
# (0-360). The color is used to derive the primary color for the output, such as
# links, navigation bars, and text. For instance a value of 0 leads to red, 120
# to green, 180 to cyan and 240 to blue. The default value is: 220.
# Minimum value: 0, maximum value: 359, default value: 220.

HTML_COLORSTYLE_HUE    = 220

# In the HTML_COLORSTYLE_SAT tag the color of the HTML output can be influenced
# by specifying the saturation of the color in degrees on the color wheel (0-100
# percent). The default value is: 100.
# Minimum value: 0, maximum value: 100, default value: 100.

HTML_COLORSTYLE_SAT    = 100

# In the HTML_COLORSTYLE_GAMMA tag the color of the HTML output can be influenced
# by specifying the gamma correction value (10-200). The default value is: 80.
# Minimum value: 10, maximum value: 200, default value: 80.

HTML_COLORSTYLE_GAMMA  = 80

# If the HTML_TIMESTAMP tag is set to YES then the generated HTML documentation
# will contain the times stamp with the date and time when the page was
# generated. Setting this to NO can help when comparing the output of multiple
# runs.
# The default value is: YES.

HTML_TIMESTAMP         = YES

# If the HTML_DYNAMIC_MENUS tag is set to YES then the generated HTML
# documentation will have a dynamic navigation menu that will show and hide
# based on mouse hover over menu items. If set to NO then the navigation menu
# will be static.
# The default value is: YES.

HTML_DYNAMIC_MENUS     = YES

# If the HTML_DYNAMIC_SECTIONS tag is set to YES then the generated HTML
# documentation will have dynamic sections that can be expanded and collapsed by
# the user. This option only works if GENERATE_TREEVIEW is set to YES.
# The default value is: NO.

HTML_DYNAMIC_SECTIONS  = NO

# With HTML_INDEX_NUM_ENTRIES one can control the preferred number of entries
# shown in the various tree structured indices initially; the user can expand
# and collapse entries dynamically later on. Doxygen will expand the tree to
# such a level that at most the specified number of entries are visible (unless
# a fully collapsed tree already exceeds this amount). So setting the number of
# entries 1 will produce a full collapsed tree by default. The default value is
# to have 100 entries. This limit applies to the main index only; every
# additional index is not affected.
# Minimum value: 1, maximum value: 9999, default value: 100.

HTML_INDEX_NUM_ENTRIES = 100

# If the GENERATE_DOCSET tag is set to YES, additional index files will be
# generated that can be used as input for Apple's Xcode documentation set.
# The default value is: NO.

GENERATE_DOCSET        = NO

# This tag determines the name of the docset feed. A documentation feed provides
# an umbrella for all (explicit) documentation versions and can be used with
# documentation browsers like Dash.
# This tag requires that the tag GENERATE_DOCSET is set to YES.

DOCSET_FEEDNAME        = "Doxygen generated docs"

# This tag specifies a string that should uniquely identify the documentation
