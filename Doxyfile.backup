# default) the formulas are rendered with a transparent background. When set to
# NO the formulas are rendered on a gray background. Since this tag is ignored
# by the HTML5 output, the formula's background color can be controlled through
# CSS (with the --formula-background-color variable) instead.
# The default value is: YES.

FORMULA_TRANSPARENT    = YES

# Enable the FORMULA_AUTO_SIZES tag to turn on the automatic resizing of the
# formula image size to the actual font size. This will slow down the generation
# of the documentation a bit, but results in much better readable formulas on
# smaller devices.
# The default value is: NO.

FORMULA_AUTO_SIZES     = NO

# The FORMULA_MACROFILE can be used to specify a file containing LaTeX macros to
# be used in formulae. Note that the file will be copied to the output
# directory for the HTML based output.
# See also: HTML_FORMULA_FILE

FORMULA_MACROFILE      = 

# If the USE_MATHJAX tag is set to YES then doxygen will generate MathJax
# output for formulas in the HTML output. MathJax is a client-side
# JavaScript library that allows to typeset LaTeX formulas in the browser.
# The default value is: NO.

USE_MATHJAX            = NO

# With MATHJAX_VERSION it is possible to specify the MathJax version to be used.
# Note that the different versions of MathJax have different requirements with
# regards to the contents of the HTML header. For MathJax version 3 the header
# will include the required JavaScript files, for MathJax version 2 the header
# will include the required JavaScript files and the MathJax configuration.
# Possible values are: MathJax_2 and MathJax_3.
# The default value is: MathJax_2.

MATHJAX_VERSION        = MathJax_2

# When MathJax is enabled you can set the default output format to be used for
# the MathJax output. For more details about the output format see MathJax
# documentation.
# Possible values are: HTML-CSS (which is slower, but has the best
# compatibility. This is the name for MathJax version 2, for MathJax version 3
# this will be translated into chtml), NativeMML (i.e. MathML. Only supported
# for MathJax version 2), chtml (which is faster and has better font selection.
# Only supported for MathJax version 3) and SVG.
# The default value is: HTML-CSS.

MATHJAX_FORMAT         = HTML-CSS

# When MathJax is enabled you need to specify the location relative to the HTML
# output directory using the MATHJAX_RELPATH option. The destination directory
# should contain the MathJax.js script. For instance, if the mathjax directory
# is located at the same level as the HTML output directory, then
# MATHJAX_RELPATH should be ../mathjax. If the MathJax.js file is available
# online via CDN, then a full URL can be provided.
# The default value relies on the MathJax CDN (currently version 2.7.2).
# Setting the value to MathJax/Auto will force doxygen to copy the MathJax
# distribution to the output directory, this can be useful in case you want to
# host the MathJax distribution from the same location as the generated HTML
# pages.

MATHJAX_RELPATH        = MathJax/Auto

# The MATHJAX_EXTENSIONS tag can be used to specify one or more MathJax
# extension names that should be enabled during MathJax rendering. This tag
# only works when MATHJAX_VERSION is set to MathJax_2.
# This tag requires that the tag USE_MATHJAX is set to YES.

MATHJAX_EXTENSIONS     = 

# The MATHJAX_CODEFILE tag can be used to specify a file with JavaScript pieces
# of code that will be used on startup of the MathJax code. See the MathJax
# site (see: http://docs.mathjax.org/en/v2.7-latest/output.html) for more
# details. This tag requires that the tag USE_MATHJAX is set to YES.

MATHJAX_CODEFILE       = 

# When the SEARCHENGINE feature is enabled doxygen will generate a search box
# for the HTML output. The underlying search engine uses JavaScript and DHTML
# and should work on any modern browser. Note that when using HTML help
# generation this search box is not enabled.
# The default value is: YES.

SEARCHENGINE           = YES

# When the SERVER_BASED_SEARCH tag is enabled the search engine will be
# implemented using a web server instead of a web client using JavaScript. There
# are two flavors of web server based searching: 1) a PHP based search, which is
# the default, and 2) the CGI based search, which can be configured using the
# SEARCHENGINE_URL tag.
# The default value is: NO.
# This tag requires that the tag SEARCHENGINE is set to YES.

SERVER_BASED_SEARCH    = NO

# When the SEARCHENGINE tag is enabled doxygen will generate a search box for
# the HTML output. If you use the server-side search engine, SEARCHENGINE_URL
# should be set to the location of the search engine. If you use the client-side
# search engine, the value of SEARCHENGINE_URL should be left empty. If you use
# a custom search handler on your website, you can map to it using this tag.
# This tag requires that the tag SEARCHENGINE is set to YES.

SEARCHENGINE_URL       = 

# When SERVER_BASED_SEARCH is enabled the SEARCHDATA_FILE tag can be used to
# specify the name of the file (without extension) that should be generated by
# doxygen which can then be used by the search engine to find all search terms
# and their associated files. Note that this tag is used both by the client and
# the server based search.
# The default file is: searchdata.
# This tag requires that the tag SEARCHENGINE is set to YES.

SEARCHDATA_FILE        = searchdata

# When SERVER_BASED_SEARCH is enabled the SEARCH_MAJICK tag can be used to
# specify the name of the file (without extension) that should be generated by
# doxygen which can then be used by the search engine to find all search terms
# and their associated files. Note that this tag is used both by the client and
# the server based search.
# The default file is: search.
# This tag requires that the tag SEARCHENGINE is set to YES.

SEARCH_MAJICK          = search

# The EXTRA_SEARCH_MAPPINGS tag can be used to add extra search terms and/or
# synonyms. Each mapping consists of two parts: the word (or phrase) to search
# for and the word (or phrase) to substitute for it when searching. These are
# separated by an equals sign. Multiple mappings can be separated by spaces or
# newlines.
# This tag requires that the tag SEARCHENGINE is set to YES.

EXTRA_SEARCH_MAPPINGS  = 

#---------------------------------------------------------------------------
# Configuration options related to the LaTeX output
#---------------------------------------------------------------------------

# If the GENERATE_LATEX tag is set to YES, doxygen will generate LaTeX output.
# The default value is: YES.

GENERATE_LATEX         = NO

# The LATEX_OUTPUT tag is used to specify where the LaTeX docs will be put. If a
# relative path is entered the value of OUTPUT_DIRECTORY will be put in front of
# it.
# The default directory is: latex.

LATEX_OUTPUT           = latex

# The LATEX_CMD_NAME tag can be used to specify the LaTeX command name to be
# invoked.
# 
# Note that when not enabling USE_PDFLATEX the default is latex when enabling
# USE_PDFLATEX the default is pdflatex and when in the immediate directory
# there is a file called "make.bat" the default is latex or pdflatex depending
# on the setting of USE_PDFLATEX.
# 
# Note that when not enabled, the commands latex, pdflatex and make are searched
# in the environment PATH.

LATEX_CMD_NAME         = 

# The MAKEINDEX_CMD_NAME tag can be used to specify the command name to generate
# index for LaTeX.
# The default file is: makeindex.

MAKEINDEX_CMD_NAME     = makeindex

# If the COMPACT_LATEX tag is set to YES, doxygen will generate more compact
# LaTeX documents. This may be useful for small projects and may help to save
# trees in general.
# The default value is: NO.

COMPACT_LATEX          = NO

# The PAPER_TYPE tag can be used to set the paper type that is used by the
# printer.
# Possible values are: a4 (210 x 297 mm), letter (8.5 x 11 inches), legal (8.5 x
# 14 inches) and executive (7.25 x 10.5 inches).
# The default value is: a4.

PAPER_TYPE             = a4

# The EXTRA_PACKAGES tag can be used to specify one or more LaTeX package names
# that should be included in the LaTeX output. The package can be specified just
# by its name or with the correct syntax as to be used with the LaTeX
# \usepackage command. To get the times font for instance you can specify :
# EXTRA_PACKAGES=times or EXTRA_PACKAGES={times}
# To use the option intlimits with the amsmath package you can specify:
# EXTRA_PACKAGES=[intlimits]{amsmath}
# If left blank no extra packages will be included.

EXTRA_PACKAGES         = 

# The LATEX_HEADER tag can be used to specify a user-defined LaTeX header for
# each generated LaTeX page. The header should contain everything until the
# first chapter. If it is left blank doxygen will generate a standard header.
# See also: LATEX_FOOTER.
# See also section "Doxygen usage" for information on how to generate the
# default header.

LATEX_HEADER           = 

# The LATEX_FOOTER tag can be used to specify a user-defined LaTeX footer for
# each generated LaTeX page. The footer should contain everything after the last
# chapter. If it is left blank doxygen will generate a standard footer.
# See also: LATEX_HEADER.
# See also section "Doxygen usage" for information on how to generate the
# default footer.

LATEX_FOOTER           = 

# The LATEX_EXTRA_STYLESHEET tag can be used to specify additional user-defined
# LaTeX style files that will be included in the LaTeX output. The file will be
# copied to the output directory. LaTeX will search for the file in the LATEX
# output directory and in the directories configured in the TEXINPUTS environment
# variable.

LATEX_EXTRA_STYLESHEET = 

# The LATEX_EXTRA_FILES tag can be used to specify one or more extra images or
# other source files which should be copied to the LATEX output directory. Note
# that the files will be copied as-is; there is no way to run them through the
# preprocessing chain.

LATEX_EXTRA_FILES      = 

# If the PDF_HYPERLINKS tag is set to YES, the LaTeX that is generated is
# prepared for conversion to PDF (using ps2pdf or pdflatex). The PDF file will
# contain links (just like the HTML output) instead of page references. This
# makes the output suitable for online browsing using a PDF viewer.
# The default value is: YES.

PDF_HYPERLINKS         = YES

# If the USE_PDFLATEX tag is set to YES, doxygen will use the pdfTeX or LuaTeX
# engine instead of plain LaTeX when generating encapsulated PostScript files
# or LaTeX files that will be converted to PDF. Set this option to YES to get a
# higher quality PDF documentation.
# The default value is: YES.

USE_PDFLATEX           = YES

# If the LATEX_BATCHMODE tag is set to YES, doxygen will add the \batchmode
# command to the generated LaTeX files. This will instruct LaTeX to keep running
# if errors occur, instead of asking the user for help. This option is also used
# when generating formulas in HTML.
# The default value is: NO.

LATEX_BATCHMODE        = NO

# If the LATEX_HIDE_INDICES tag is set to YES then doxygen will not include the
# index chapters (such as File Index, Compound Index, etc.) in the output.
# The default value is: NO.

LATEX_HIDE_INDICES     = NO

# If the LATEX_BIB_STYLE tag is set to a name then doxygen will use this name
# for the bibliography style file when generating LaTeX output. The default
# value is: plain.bst.

LATEX_BIB_STYLE        = plain.bst

# If the LATEX_TIMESTAMP tag is set to YES then the generated LaTeX
# documentation will contain the time and date when the page was generated.
# Setting this to NO can help when comparing the output of multiple runs.
# The default value is: YES.

LATEX_TIMESTAMP        = NO

# The LATEX_EMOJI_DIRECTORY tag is used to specify the (relative or absolute)
# path from which the emoji images will be read. If you specify a relative path
# it will be relative to the LATEX_OUTPUT directory. If left blank the
# LATEX_OUTPUT directory will be used.

LATEX_EMOJI_DIRECTORY  = 

#---------------------------------------------------------------------------
# Configuration options related to the RTF output
#---------------------------------------------------------------------------

# If the GENERATE_RTF tag is set to YES, doxygen will generate RTF output. The
# RTF output is optimized for Word 97 and may not look too pretty with other RTF
# readers/editors.
# The default value is: NO.

GENERATE_RTF           = NO

# The RTF_OUTPUT tag is used to specify where the RTF docs will be put. If a
# relative path is entered the value of OUTPUT_DIRECTORY will be put in front of
# it.
# The default directory is: rtf.

RTF_OUTPUT             = rtf

# If the COMPACT_RTF tag is set to YES, doxygen will generate more compact RTF
# documents. This may be useful for small projects and may help to save trees in
# general.
# The default value is: NO.

COMPACT_RTF            = NO

# If the RTF_HYPERLINKS tag is set to YES, the RTF that is generated will
# contain hyperlink fields. The RTF file will contain links (just like the HTML
# output) instead of page references. This makes the output suitable for online
# browsing using Word or some other Word compatible readers that support those
# fields.
# 
# Note: WordPad (write) and others do not support links.
# The default value is: NO.

RTF_HYPERLINKS         = NO

# Load stylesheet definitions from file. Syntax is similar to doxygen's
# configuration file, i.e. a series of assignments. You only have to provide
# replacements, missing definitions are set to their default value.

RTF_STYLESHEET_FILE    = 

# Set optional variables used in the generation of an RTF document.
# Syntax is similar to doxygen's configuration file.

RTF_EXTENSIONS_FILE    = 

# If the RTF_SOURCE_CODE tag is set to YES then doxygen will include source code
# with syntax highlighting in the RTF output.
# The default value is: NO.

RTF_SOURCE_CODE        = NO

#---------------------------------------------------------------------------
# Configuration options related to the man page output
#---------------------------------------------------------------------------

# If the GENERATE_MAN tag is set to YES, doxygen will generate man pages for
# classes and files.
# The default value is: NO.

GENERATE_MAN           = NO

# The MAN_OUTPUT tag is used to specify where the man pages will be put. If a
# relative path is entered the value of OUTPUT_DIRECTORY will be put in front of
# it. A directory man3 will be created inside the directory specified by
# MAN_OUTPUT.
# The default directory is: man.

MAN_OUTPUT             = man

# The MAN_EXTENSION tag is used to determine the extension that is added to the
# generated man pages. In case the manual section deserves a different name,
# you can specify it using MAN_EXTENSION.
# The default value is: 3.

MAN_EXTENSION          = 3

# The MAN_SUBDIR tag determines the name of the directory created within
# MAN_OUTPUT in which the man pages are placed. If defaults to man followed by
# MAN_EXTENSION. For better integration with KDE, set this to kde which will
# result in a "kde" subdirectory.
# The default directory is: man3.

MAN_SUBDIR             = man3

# If the MAN_LINKS tag is set to YES and doxygen generates man output, then it
# will generate one additional man file for each entity documented in the real
# man page(s). These additional files will only contain the name of the entity
# and a reference to the real entry.
# The default value is: NO.

MAN_LINKS              = NO

#---------------------------------------------------------------------------
# Configuration options related to the XML output
#---------------------------------------------------------------------------

# If the GENERATE_XML tag is set to YES, doxygen will generate an XML file that
# captures the structure of the code including all documentation.
# The default value is: NO.

GENERATE_XML           = NO

# The XML_OUTPUT tag is used to specify where the XML pages will be put. If a
# relative path is entered the value of OUTPUT_DIRECTORY will be put in front of
# it.
# The default directory is: xml.

XML_OUTPUT             = xml

# If the XML_PROGRAMLISTING tag is set to YES, doxygen will dump the program
# listings in the XML output. If set to NO the listings will be excluded from
# the XML output. Note that the listings are always included in the HTML output
# regardless of this setting.
# The default value is: YES.

XML_PROGRAMLISTING     = YES

# If the XML_NS_MEMB_FILE_SCOPE tag is set to YES, doxygen will include
# namespace members in file scope within the XML output. If set to NO, namespace
# members in file scope will be excluded from the XML output. This applies to
# namespace members that are not enclosed within a class or another scope.
# The default value is: NO.

XML_NS_MEMB_FILE_SCOPE = NO

#---------------------------------------------------------------------------
# Configuration options related to the DOCBOOK output
#---------------------------------------------------------------------------

# If the GENERATE_DOCBOOK tag is set to YES, doxygen will generate Docbook files
# that can be used to generate PDF, HTML, man, RTF, and other formats.
# The default value is: NO.

GENERATE_DOCBOOK       = NO

# The DOCBOOK_OUTPUT tag is used to specify where the Docbook pages will be put.
# If a relative path is entered the value of OUTPUT_DIRECTORY will be put in
# front of it.
# The default directory is: docbook.

DOCBOOK_OUTPUT         = docbook

# If the DOCBOOK_PROGRAMLISTING tag is set to YES, doxygen will include the
# program listings in the Docbook output. If set to NO the listings will be
# excluded from the Docbook output. Note that the listings are always included
# in the HTML output regardless of this setting.
# The default value is: NO.

DOCBOOK_PROGRAMLISTING = NO

#---------------------------------------------------------------------------
# Configuration options for the AutoGen Definitions output
#---------------------------------------------------------------------------

# If the GENERATE_AUTOGEN_DEF tag is set to YES, doxygen will generate an
# AutoGen Definitions (see autogen.sf.net) file that captures the structure of
# the code including all documentation. Note that this feature is still
# experimental and incomplete at the moment.
# The default value is: NO.

GENERATE_AUTOGEN_DEF   = NO

#---------------------------------------------------------------------------
# Configuration options related to the Perl module output
#---------------------------------------------------------------------------

# If the GENERATE_PERLMOD tag is set to YES, doxygen will generate a Perl module
# file that captures the structure of the code including all documentation.
# 
# Note that this feature is still experimental and incomplete at the moment.
# The default value is: NO.

GENERATE_PERLMOD       = NO

# If the PERLMOD_LATEX tag is set to YES, doxygen will generate the necessary
# Makefile rules, Perl scripts and LaTeX code to be able to generate PDF and DVI
# output from the Perl module output.
# The default value is: NO.
# This tag requires that the tag GENERATE_PERLMOD is set to YES.

PERLMOD_LATEX          = NO

# If the PERLMOD_PRETTY tag is set to YES, the Perl module output will be nicely
# formatted so it can be parsed by a human reader. This is useful if you want to
# understand what is going on. On the other hand, if this tag is set to NO, the
# size of the Perl module output will be much smaller and Perl will parse it
# just the same.
# The default value is: YES.
# This tag requires that the tag GENERATE_PERLMOD is set to YES.

PERLMOD_PRETTY         = YES

# The names of the make variables in the generated doxyrules.make file are
# prefixed with the string contained in PERLMOD_MAKEVAR_PREFIX. This is useful
# so different doxyrules.make files included by the same Makefile don't
# overwrite each other's variables.
# This tag requires that the tag GENERATE_PERLMOD is set to YES.

PERLMOD_MAKEVAR_PREFIX = 

#---------------------------------------------------------------------------
# Configuration options related to the preprocessor
#---------------------------------------------------------------------------

# If the ENABLE_PREPROCESSING tag is set to YES (the default), doxygen will
# evaluate all C-preprocessor directives found in the sources and include files.
# The default value is: YES.

ENABLE_PREPROCESSING   = YES

# Set the MACRO_EXPANSION tag to YES to enable macro expansion within code
# snippets in the documentation. Note that this feature is still experimental
# and incomplete at the moment.
# The default value is: NO.

MACRO_EXPANSION        = NO

# When the EXPAND_ONLY_PREDEF tag is set to YES doxygen will only expand
# macros that are defined in the PREDEFINED or EXPAND_AS_DEFINED tags and not
# other macros found in the sources.
# The default value is: NO.

EXPAND_ONLY_PREDEF     = NO

# If the SEARCH_INCLUDES tag is set to YES (the default), the include files in
# the INCLUDE_PATH will be searched if a #include is found.
# The default value is: YES.

SEARCH_INCLUDES        = YES

# The INCLUDE_PATH tag can be used to specify one or more directories that
# contain include files that are not input files but should be processed by the
# preprocessor.
# This tag requires that the tag ENABLE_PREPROCESSING is set to YES.

INCLUDE_PATH           = 

# You can use the INCLUDE_FILE_PATTERNS tag to specify one or more wildcard
# patterns (like *.h and *.hpp) to filter out the header-files in the
# directories. If left blank, the patterns specified with FILE_PATTERNS will be
# used.

INCLUDE_FILE_PATTERNS  = 

# The PREDEFINED tag can be used to specify one or more macro names that are
# defined before the preprocessor starts on the input to replace them with zero
# or more arguments. The argument list is checked for correct expressions and
# is passed to the preprocessor as a replacement. The preprocessor output is
# still parsed, but all the macro definitions inside the block are only
# considered when preprocessing is done. Macro expansion is not available if
# the grouping of statements is too complex.

PREDEFINED             = 

# If the EXPAND_AS_DEFINED tag is set to YES, doxygen will also expand macros
# that are inside an #undef statement. Set to NO if you want to disable this
# feature.
# The default value is: NO.

EXPAND_AS_DEFINED      = NO

# If the SKIP_FUNCTION_MACROS tag is set to YES (the default) then doxygen's
# preprocessor will remove all references to function-like macros that are alone
# on a line, have an all uppercase name, and do not end with a semicolon. Such
# function macros are typically used for boiler-plate code, and will confuse the
# parser.
# The default value is: YES.

SKIP_FUNCTION_MACROS   = YES

#---------------------------------------------------------------------------
# Configuration options related to external references
#---------------------------------------------------------------------------

# The TAGFILES tag can be used to specify one or more tag files. For each tag
# file the location of the external documentation should be added. The format of
# a tag file without this location is as follows:
# TAGFILES = file1 file2 ...
# Adding location for the tag files is done as follows:
# TAGFILES = file1=loc1 "file2 = loc2" ...
# where loc1 and loc2 can be relative or absolute paths or URLs. See the
# section "Linking to external documentation" for more information about the use
# of tag files.
# Note: Each tag file must be located in a directory. If not, doxygen will not
# be able to find the correct location of the tag file.

TAGFILES               = 

# When linking to external documentation doxygen will use the file from the
# TAGFILES option to lookup the external documentation. The external
# documentation should have a corresponding tag file that contains the
# information about the documented objects. If the tag file is not located at
# the same location as the external documentation, the 'externalLocation'
# parameter should be specified along with the tag file location. The
# externalLocation parameter specifies the location of the external documentation
# relative to the tag file location. If the externalLocation parameter is not
# specified, doxygen will assume that the external documentation is located at
# the same location as the tag file.

EXTERNAL_GROUPS        = YES

# When linking to external documentation doxygen will use the file from the
# TAGFILES option to lookup the external documentation. The external
# documentation should have a corresponding tag file that contains the
# information about the documented objects. If the tag file is not located at
# the same location as the external documentation, the 'externalLocation'
# parameter should be specified along with the tag file location. The
# externalLocation parameter specifies the location of the external documentation
# relative to the tag file location. If the externalLocation parameter is not
# specified, doxygen will assume that the external documentation is located at
# the same location as the tag file.

EXTERNAL_PAGES         = YES

# The PERL_PATH should be the absolute path and name of the perl script
# interpreter (i.e. the result of 'which perl').
# The default file (with absolute path) is: /usr/bin/perl.

PERL_PATH              = /usr/bin/perl

#---------------------------------------------------------------------------
# Configuration options related to the dot tool
#---------------------------------------------------------------------------

# If the CLASS_DIAGRAMS tag is set to YES (the default) doxygen will generate
# a class diagram (in HTML and LaTeX). The aforementioned class diagram will be
# "inline" and has a limited scaling factor. If you want a more enhanced class
# diagram you can set this option to NO and apply the (external) Graphviz tool
# to generate better looking class diagrams by enabling the HAVE_DOT option and
# setting the CLASS_GRAPH, COLLABORATION_GRAPH, and GRAPHICAL_HIERARCHY options
# to YES.
# The default value is: YES.

CLASS_DIAGRAMS         = YES

# You can define message sequence charts within doxygen comments using the \msc
# command. Doxygen will then run the mscgen tool (see: http://www.mcternan.me.uk/mscgen/)
# to produce the chart and insert it in the documentation. The MSCGEN_TOOL tag
# allows you to specify the path where the mscgen tool has been installed. If
# left empty the tool is assumed to be found in the default search path.

MSCGEN_TOOL            = 

# You can include diagrams made with dia in doxygen documentation. Doxygen will
# then run the dia tool (see: https://wiki.gnome.org/Apps/Dia/) to produce the
# diagram and insert it in the documentation. The DIA_PATH tag allows you to
# specify the path where the dia tool has been installed. If left empty the tool
# is assumed to be found in the default search path.

DIA_PATH               = 

# If set to YES the inheritance and collaboration graphs will hide inheritance
# links that are only used for services (i.e. convenience classes not intended
# to be used by end-users).
# The default value is: NO.

HIDE_UNDOC_RELATIONS   = YES

# If you set the HAVE_DOT tag to YES then doxygen will assume the dot tool is
# available from the path. This tool is part of Graphviz (see:
# http://www.graphviz.org/), a graph visualization toolkit from AT&T and Lucent
# Bell Labs. The other options in this section have no effect if this option is
# set to NO
# The default value is: NO.

HAVE_DOT               = NO

# The DOT_NUM_THREADS specifies the number of dot invocations doxygen is allowed
# to run in parallel. When set to 0 doxygen will base this on the number of
# processors available in the system. You can set it explicitly to a value
# larger than 0 to get control over the balance between CPU load and processing
# speed.
# Minimum value: 0, maximum value: 32, default value: 0.
# This tag requires that the tag HAVE_DOT is set to YES.

DOT_NUM_THREADS        = 0

# When you want a differently looking font in the dot files that doxygen
# generates you can specify the font name using DOT_FONTNAME. You need to make
# sure dot is able to find the font, which can be done by putting it in a
# standard location or by setting the DOTFONTPATH environment variable or by
# setting the FONTCONFIG_PATH environment variable for dot on Linux systems.
# The default value is: Helvetica.
# This tag requires that the tag HAVE_DOT is set to YES.

DOT_FONTNAME           = Helvetica

# The DOT_FONTSIZE tag can be used to set the size (in points) of the font to
# use for the dot diagrams. The default size is 10.
# Minimum value: 4, maximum value: 24, default value: 10.
# This tag requires that the tag HAVE_DOT is set to YES.

DOT_FONTSIZE           = 10

# By default doxygen will tell dot to use the default font as specified with
# DOT_FONTNAME. If you specify a different font using DOT_FONTNAME you can set
# the path where dot can find it using this tag.
# This tag requires that the tag HAVE_DOT is set to YES.

DOT_FONTPATH           = 

# If the CLASS_GRAPH tag is set to YES (the default) an inheritance graph will
# be generated for each documented class.
# The default value is: YES.
# This tag requires that the tag HAVE_DOT is set to YES.

CLASS_GRAPH            = YES

# If the COLLABORATION_GRAPH tag is set to YES then there will be a graph for
# each documented class showing the direct and indirect implementation
# dependencies (inheritance, containment, and class references variables) of the
# class with other documented classes.
# The default value is: YES.
# This tag requires that the tag HAVE_DOT is set to YES.

COLLABORATION_GRAPH    = YES

# If the GROUP_GRAPHS tag is set to YES then doxygen will generate a graph for
# groups, showing the direct groups dependencies.
# The default value is: YES.
# This tag requires that the tag HAVE_DOT is set to YES.

GROUP_GRAPHS           = YES

# If the UML_LOOK tag is set to YES, doxygen will generate inheritance and
# collaboration diagrams in a style similar to the OMG's Unified Modeling
# Language.
# The default value is: NO.
# This tag requires that the tag HAVE_DOT is set to YES.

UML_LOOK               = NO

# If the UML_LOOK tag is enabled, the fields and methods will be visualized in
# the class inheritance diagram with their member specification (static/virtual/abstract).
# Enabling this option might lead to wide diagrams.
# The default value is: NO.
# This tag requires that the tag UML_LOOK is set to YES.

UML_LIMIT_NUM_FIELDS   = NO

# If the DOT_PAPER_SIZE tag is set to A4, doxygen will assume the paper size is
# A4 (8.27 x 11.69 inches). If the size is specified as A3 (11.69 x 16.54
# inches), doxygen will assume the paper size is A3. If the size is specified
# as A2 (16.54 x 23.39 inches), doxygen will assume the paper size is A2. If
# the size is specified as A1 (23.39 x 33.11 inches), doxygen will assume the
