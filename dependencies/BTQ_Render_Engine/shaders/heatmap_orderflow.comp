#version 450 core

layout(local_size_x = 16, local_size_y = 16) in;

layout(set = 0, binding = 0, std430) readonly buffer OrderbookData {
    float levels[]; // [price, size, price, size, ...]
} orderbook;

layout(set = 0, binding = 1, rgba8) uniform writeonly image2D heatmap_texture;

layout(push_constant) uniform PushConstants {
    vec2 price_range; // [min_price, max_price]
    uint num_levels;
    uint current_column;
    float intensity_scale;
} pc;

vec3 get_heatmap_color(float intensity) {
    // Red-Hot Heatmap Style
    vec3 color = vec3(0.0);
    color.r = smoothstep(0.0, 0.5, intensity);
    color.g = smoothstep(0.3, 0.8, intensity);
    color.b = smoothstep(0.6, 1.0, intensity);
    return color;
}

void main() {
    uvec2 gid = gl_GlobalInvocationID.xy;
    ivec2 tex_size = imageSize(heatmap_texture);
    
    if (gid.x >= tex_size.x || gid.y >= tex_size.y) return;
    
    // We only update the current column (or vertical slice) corresponding to the latest data
    if (gid.x != pc.current_column) return;

    float price_step = (pc.price_range.y - pc.price_range.x) / float(tex_size.y);
    float target_price = pc.price_range.x + float(gid.y) * price_step;

    float total_size = 0.0;
    
    // Simple binning: find orderbook levels close to this pixel's price
    for (uint i = 0; i < pc.num_levels; i++) {
        float p = orderbook.levels[i * 2];
        float s = orderbook.levels[i * 2 + 1];
        
        float dist = abs(p - target_price);
        if (dist < price_step) {
            total_size += s * (1.0 - dist / price_step);
        }
    }

    float intensity = clamp(total_size * pc.intensity_scale, 0.0, 1.0);
    vec4 final_color = vec4(get_heatmap_color(intensity), 1.0);
    
    imageStore(heatmap_texture, ivec2(gid.x, gid.y), final_color);
}
