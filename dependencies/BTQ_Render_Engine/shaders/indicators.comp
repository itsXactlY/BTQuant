#version 450

layout(local_size_x = 256) in;

struct Candle {
    float open;
    float high;
    float low;
    float close;
    float volume;
    uint t_low;
    uint t_high;
};

layout(std430, binding = 0) readonly buffer InputCandles {
    Candle candles[];
};

layout(std430, binding = 1) writeonly buffer OutputSMA {
    float sma[];
};

layout(push_constant) uniform Params {
    uint count;
    uint period;
} p;

void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= p.count) return;

    if (idx < p.period - 1) {
        sma[idx] = candles[idx].close;
        return;
    }

    float sum = 0.0;
    for (uint i = 0; i < p.period; ++i) {
        sum += candles[idx - i].close;
    }
    sma[idx] = sum / float(p.period);
}
