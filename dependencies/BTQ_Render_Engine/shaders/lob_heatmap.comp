// LOB Heatmap Compute Shader — VolumeNode Cluster Edition
// Vulkan 1.3 — Market Microstructure Terminal
// Reads HotSpine::V3::VolumeNode SSBO, outputs RGBA16F heatmap texture
// X = column index (time), Y = row index (price level)

#version 460 core

// ========================================
// SSBO: Flat VolumeNode array (std430)
// ========================================
// Matches HotSpine::V3::VolumeNode exactly:
//   float    buy_vol;      // offset 0, 4B
//   float    sell_vol;     // offset 4, 4B
//   uint     trade_count;  // offset 8, 4B (uint16 packed as uint32 in std430)
//   uint     tpo_bits;     // offset 12, 4B (uint16 packed as uint32 in std430)
// sizeof = 16 bytes per node

struct VolumeNode {
    float buy_vol;
    float sell_vol;
    uint  trade_count;  // std430: uint16_t → uint
    uint  tpo_bits;     // std430: uint16_t → uint
};

layout(set = 0, binding = 0, std430) readonly buffer ClusterSSBO {
    VolumeNode nodes[];  // Flat array: column * 256 + row
} ssbo;

layout(set = 0, binding = 1, rgba16f) writeonly uniform image2D heatmap_out;

// ========================================
// Push Constants
// ========================================
layout(push_constant) uniform PushConstants {
    float max_volume;   // Running max from CPU side for normalization
    float alpha;        // Overall heatmap opacity (default 0.3)
} pc;

// ========================================
// Workgroup Configuration
// ========================================
// 1024 columns × 256 rows
// local_size: 16×16 = 256 threads per workgroup
// Dispatch: (1024/16, 256/16, 1) = (64, 16, 1)
layout(local_size_x = 16, local_size_y = 16) in;

// ========================================
// MMT Color Palette
// ========================================
const vec3 VOID_COLOR   = vec3(0.043, 0.055, 0.067);  // #0B0E11 — Deep Void background
const vec3 NEON_MINT    = vec3(0.0, 0.9, 0.4);        // Buy-side (bid hit)
const vec3 FIRE_ORANGE  = vec3(1.0, 0.5, 0.0);        // Sell-side (ask hit)

// ========================================
// Main
// ========================================
void main() {
    uint col = gl_GlobalInvocationID.x;
    uint row = gl_GlobalInvocationID.y;

    // Bounds check: 1024 columns × 256 rows
    if (col >= 1024 || row >= 256) return;

    uint idx = col * 256 + row;
    VolumeNode node = ssbo.nodes[idx];

    float denom = max(pc.max_volume, 1.0);
    float bid_intensity = node.buy_vol  / denom;
    float ask_intensity = node.sell_vol / denom;

    // Start from void, additively blend buy (mint) and sell (orange)
    vec4 color = vec4(VOID_COLOR, 0.0);

    if (bid_intensity > 0.0) {
        color = mix(color, vec4(NEON_MINT,  pc.alpha), clamp(bid_intensity, 0.0, 1.0));
    }
    if (ask_intensity > 0.0) {
        color = mix(color, vec4(FIRE_ORANGE, pc.alpha), clamp(ask_intensity, 0.0, 1.0));
    }

    imageStore(heatmap_out, ivec2(col, row), color);
}