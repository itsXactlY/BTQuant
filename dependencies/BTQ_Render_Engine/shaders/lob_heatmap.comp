// LOB Heatmap Compute Shader
// Vulkan 1.3 - Market Microstructure Renderer
// MMT Deep Void palette: void #0B0E11 base, Neon Mint bids, Orange asks
// Computes limit order book depth evolution as a cyclic heatmap texture
// Price level -> Y-coordinate, Time -> X-coordinate

#version 460 core
#extension GL_EXT_nonuniform_qualifier : enable
#extension GL_EXT_scalar_block_layout : enable

// ========================================
// SSBO Structures (GPU-CPU aligned)
// ========================================

// Order Book Level Structure (std430 aligned)
struct OrderBookLevel {
    float price;           // Price level
    uint askQuantity;      // Ask volume at this price
    uint bidQuantity;      // Bid volume at this price
    uint numOrders;        // Number of orders at this price
};

// Hotspine Order Book Snapshot (SSBO)
layout(std430, set = 0, binding = 0) readonly buffer OrderBookSnapshot {
    uint currentTimeIndex;     // Current cyclic time index
    uint priceLevelsCount;     // Number of price levels
    float basePrice;           // Base price for rendering
    float priceRange;          // Price range to display
    OrderBookLevel levels[];   // Variable-length price levels
} orderBook;

// Heatmap Texture Output (Image2D)
layout(binding = 1, rgba32f) uniform image2D heatmapOutput;

// ========================================
// Push Constants (matches HeatmapPushConstants on the C++ side)
// ========================================

layout(push_constant) uniform PushConstants {
    float max_volume;   // Running max volume for normalization
    float alpha;        // Output alpha (0.3 default)
} pc;

// ========================================
// Specialization constants
// ========================================

layout(constant_id = 0) const uint MAX_LIQUIDITY = 1000;
layout(constant_id = 1) const bool INVERT_Y_AXIS = true;

// ========================================
// Constants
// ========================================

const vec3 VOID_COLOR   = vec3(0.043, 0.055, 0.067);  // #0B0E11 deep void base
const vec3 NEON_MINT    = vec3(0.0,   0.9,   0.4);    // Bid color
const vec3 ORANGE       = vec3(1.0,   0.5,   0.0);    // Ask color

// ========================================
// Helper Functions
// ========================================

// Normalize price to [0, height] coordinate
float priceToY(float price) {
    float normalizedPrice = (price - orderBook.basePrice) / orderBook.priceRange;
    float y = normalizedPrice * float(orderBook.priceLevelsCount);

    if (INVERT_Y_AXIS) {
        // Map normalizedPrice (0..1) to (height-1..0)
        return float(orderBook.priceLevelsCount) - 1.0 - y;
    }
    return y;
}

// Per-node MMT Deep Void color mapping
// - base: deep void #0B0E11
// - bid_intensity > 0: mix toward Neon Mint
// - ask_intensity > 0: mix toward Orange
vec4 nodeColor(float buy_vol, float sell_vol) {
    float denom = max(pc.max_volume, 1.0);
    float bid_intensity = clamp(buy_vol  / denom, 0.0, 1.0);
    float ask_intensity = clamp(sell_vol / denom, 0.0, 1.0);

    vec4 color = vec4(VOID_COLOR, 1.0);
    if (bid_intensity > 0.0) {
        color = mix(color, vec4(NEON_MINT, pc.alpha), bid_intensity);
    }
    if (ask_intensity > 0.0) {
        color = mix(color, vec4(ORANGE, pc.alpha), ask_intensity);
    }
    return color;
}

// ========================================
// Main Compute Shader Entry
// ========================================

layout(local_size_x = 1, local_size_y = 64) in;

void main() {
    uint yIndex = gl_GlobalInvocationID.y;

    // Check if thread is within heatmap bounds
    if (yIndex >= orderBook.priceLevelsCount) {
        return;
    }

    // Current time column to update (cyclic buffer)
    uint currentCol = orderBook.currentTimeIndex % 1024u;  // history width
    ivec2 targetCoords = ivec2(currentCol, yIndex);

    // Find matching price level using Binary Search (Assumes levels are sorted by price)
    float targetPrice = orderBook.basePrice + (float(yIndex) / float(orderBook.priceLevelsCount)) * orderBook.priceRange;

    int low = 0;
    int high = int(orderBook.priceLevelsCount) - 1;
    int closestIdx = -1;
    float minDistance = 1e9;

    while (low <= high) {
        int mid = (low + high) / 2;
        float levelPrice = orderBook.levels[mid].price;
        float dist = abs(levelPrice - targetPrice);

        if (dist < minDistance) {
            minDistance = dist;
            closestIdx = mid;
        }

        if (levelPrice < targetPrice) {
            low = mid + 1;
        } else if (levelPrice > targetPrice) {
            high = mid - 1;
        } else {
            break; // Exact match
        }
    }

    float buy_vol  = 0.0;
    float sell_vol = 0.0;
    // Only render if the match is within the pixel's price bin
    if (closestIdx != -1 && minDistance < (orderBook.priceRange / float(orderBook.priceLevelsCount))) {
        buy_vol  = float(orderBook.levels[closestIdx].bidQuantity);
        sell_vol = float(orderBook.levels[closestIdx].askQuantity);
    }

    // Compute pixel color (MMT Deep Void palette)
    vec4 color = nodeColor(buy_vol, sell_vol);

    // Write to heatmap texture at the current cyclic column
    imageStore(heatmapOutput, targetCoords, color);
}
