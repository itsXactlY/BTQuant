            })
            
    def _test_concurrent_access(self):
        """Test 7: Verify concurrent access works."""
        self.log("\n--- Test 7: Concurrent Access ---")
        test_name = "concurrent_access"
        
        if self.reader is None:
            self.reader = create_reader()
            
        if self.reader is None:
            self.log("✗ No reader available for concurrent access test", "ERROR")
            self.test_results.append({
                "test": test_name,
                "passed": False,
                "message": "No reader available"
            })
            return
            
        errors = []
        results = {}
        
        def reader_thread(thread_id: int):
            """Thread that reads data."""
            try:
                for _ in range(5):
                    stats = self.reader.get_buffer_stats()
                    health = self.reader.get_health_status()
                    results[thread_id] = (stats, health)
                    time.sleep(0.1)
            except Exception as e:
                errors.append(f"Thread {thread_id}: {e}")
                
        # Start multiple reader threads
        threads = []
        for i in range(3):
            t = threading.Thread(target=reader_thread, args=(i,))
            threads.append(t)
            t.start()
            
        # Wait for all threads
        for t in threads:
            t.join()
            
        if errors:
            self.log(f"✗ Concurrent access errors: {errors}", "ERROR")
            self.test_results.append({
                "test": test_name,
                "passed": False,
                "message": str(errors)
            })
        else:
            self.log(f"✓ Concurrent access successful (3 threads, 5 reads each)")
            self.test_results.append({
                "test": test_name,
                "passed": True,
                "message": f"3 threads completed successfully"
            })
            
    def _print_summary(self):
        """Print test summary."""
        self.log("\n" + "=" * 60)
        self.log("Test Summary")
        self.log("=" * 60)
        
        passed = sum(1 for r in self.test_results if r["passed"])
        failed = sum(1 for r in self.test_results if not r["passed"])
        total = len(self.test_results)
        
        self.log(f"Total tests: {total}")
        self.log(f"Passed: {passed}")
        self.log(f"Failed: {failed}")
        
        if failed > 0:
            self.log("\nFailed tests:")
            for r in self.test_results:
                if not r["passed"]:
                    self.log(f"  - {r['test']}: {r['message']}")
                    
        self.log("\n" + "=" * 60)
        
        # Return exit code based on results
        return failed == 0


def run_with_collector(collector_path: str, timeout: int = 60):
    """
    Run integration tests with the C++ collector.
    
    Args:
        collector_path: Path to the C++ collector executable
        timeout: Maximum time to run in seconds
    """
    import subprocess
    
    test_runner = IntegrationTestRunner(timeout_seconds=timeout)
    
    # Check if collector exists
    if not os.path.exists(collector_path):
        print(f"Collector not found at: {collector_path}")
        print("Please ensure the C++ market_data_collector is built and running.")
        print("\nTo build and run the collector:")
        print("  1. cd dependencies/ccapi/example/build/src/market_data_collector")
        print("  2. cmake .. && make")
        print("  3. ./market_data_collector")
        print("\nThen run this test in another terminal:")
        print("  python3 test_hotspine_reader_integration.py")
        return False
        
    print(f"Found collector at: {collector_path}")
    
    # Start collector in background
    print("\nStarting C++ collector...")
    collector_proc = subprocess.Popen(
        [collector_path],
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        cwd=os.path.dirname(collector_path)
    )
    
    try:
        # Wait for collector to initialize
        print("Waiting for collector to initialize...")
        time.sleep(3)
        
        # Check if collector is still running
        if collector_proc.poll() is not None:
            stdout, stderr = collector_proc.communicate()
            print(f"Collector exited prematurely!")
            print(f"stdout: {stdout.decode()}")
            print(f"stderr: {stderr.decode()}")
            return False
            
        print("Collector is running. Starting integration tests...\n")
        
        # Run tests
        success = test_runner.run_all_tests()
        
        return success
        
    finally:
        # Stop collector
        print("\nStopping collector...")
        collector_proc.terminate()
        try:
            collector_proc.wait(timeout=5)
        except subprocess.TimeoutExpired:
            collector_proc.kill()
            collector_proc.wait()
        print("Collector stopped.")


def main():
    """Main entry point."""
    import argparse
    
    parser = argparse.ArgumentParser(
        description="Integration test for HotSpine Reader against live C++ collector"
    )
    parser.add_argument(
        "--collector", "-c",
        default="dependencies/ccapi/example/build/src/market_data_collector/market_data_collector",
        help="Path to the C++ market_data_collector executable"
    )
    parser.add_argument(
        "--timeout", "-t",
        type=int,
        default=60,
        help="Maximum time to run tests (default: 60 seconds)"
    )
    parser.add_argument(
        "--no-collector",
        action="store_true",
        help="Run tests without starting collector (assumes it's already running)"
    )
    
    args = parser.parse_args()
    
    if args.no_collector:
        # Just run tests, assume collector is already running
        test_runner = IntegrationTestRunner(timeout_seconds=args.timeout)
        success = test_runner.run_all_tests()
        sys.exit(0 if success else 1)
    else:
        # Start collector and run tests
        success = run_with_collector(args.collector, args.timeout)
        sys.exit(0 if success else 1)


if __name__ == "__main__":
    main()
