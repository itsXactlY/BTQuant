#!/usr/bin/env python3
"""
Integration test for HotSpine Reader against live C++ Market Data Collector.

This script tests that the Python HotSpine reader can fully read the hotspine
architecture while the C++ market_data_collector is running and producing data.

Usage:
    # First, start the C++ collector in one terminal:
    # cd dependencies/ccapi/example/build/src/market_data_collector
    # ./market_data_collector
    
    # Then, run this test in another terminal:
    # python3 test_hotspine_reader_integration.py
    
    # Or run both in background:
    # ./run_integration_test.sh
"""

import sys
import time
import threading
import signal
import os
from datetime import datetime
from typing import Optional

# Add parent directory to path for imports
sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))

from python_market_data_collector.hotspine_reader import (
    HotSpineReader, HotSpineDataType, create_reader, create_reader_for_type
)
from python_market_data_collector.market_data_types import (
    Trade, OrderbookSnapshot, OHLCV
)


class IntegrationTestRunner:
    """Run integration tests against live HotSpine data."""
    
    def __init__(self, timeout_seconds: int = 30):
        self.timeout_seconds = timeout_seconds
        self.stop_event = threading.Event()
        self.test_results = []
        self.reader: Optional[HotSpineReader] = None
        
    def log(self, message: str, level: str = "INFO"):
        """Log a message with timestamp."""
        timestamp = datetime.now().isoformat()
        print(f"[{timestamp}][{level}] {message}")
        
    def run_all_tests(self):
        """Run all integration tests."""
        self.log("=" * 60)
        self.log("HotSpine Reader Integration Tests")
        self.log(f"Timeout: {self.timeout_seconds} seconds")
        self.log("=" * 60)
        
        # Test 1: Reader creation
        self._test_reader_creation()
        
        # Test 2: Buffer monitoring
        self._test_buffer_monitoring()
        
        # Test 3: Data reading (trades)
        self._test_trade_reading()
        
        # Test 4: Data reading (orderbooks)
        self._test_orderbook_reading()
        
        # Test 5: Health monitoring
        self._test_health_monitoring()
        
        # Test 6: Symbol mapping
        self._test_symbol_mapping()
        
        # Test 7: Concurrent access
        self._test_concurrent_access()
        
        # Summary
        self._print_summary()
        
    def _test_reader_creation(self):
        """Test 1: Verify reader can be created."""
        self.log("\n--- Test 1: Reader Creation ---")
        test_name = "reader_creation"
        
        try:
            # Test creating reader for all data types
            for data_type in HotSpineDataType:
                self.log(f"Creating reader for {data_type.name}...")
                reader = create_reader_for_type(data_type)
                if reader is not None:
                    self.log(f"  ✓ Created reader for {data_type.name}")
                    self.test_results.append({
                        "test": f"{test_name}_{data_type.name}",
                        "passed": True,
                        "message": f"Reader created for {data_type.name}"
                    })
                else:
                    self.log(f"  ✗ Failed to create reader for {data_type.name}", "WARNING")
                    self.test_results.append({
                        "test": f"{test_name}_{data_type.name}",
                        "passed": False,
                        "message": f"Reader not available for {data_type.name}"
                    })
                    
        except Exception as e:
            self.log(f"✗ Reader creation test failed: {e}", "ERROR")
            self.test_results.append({
                "test": test_name,
                "passed": False,
                "message": str(e)
            })
            
    def _test_buffer_monitoring(self):
        """Test 2: Verify buffer monitoring works."""
        self.log("\n--- Test 2: Buffer Monitoring ---")
        test_name = "buffer_monitoring"
        
        try:
            self.reader = create_reader()
            if self.reader is None:
                self.log("✗ No reader available for buffer monitoring", "ERROR")
                self.test_results.append({
                    "test": test_name,
                    "passed": False,
                    "message": "No reader available"
                })
                return
                
            # Get buffer statistics
            stats = self.reader.get_buffer_stats()
            self.log(f"Buffer statistics: {stats}")
            
            if "num_trades_buffers" in stats or "num_books_buffers" in stats:
                self.log("✓ Buffer statistics retrieved successfully")
                self.test_results.append({
                    "test": test_name,
                    "passed": True,
                    "message": f"Buffer stats: {stats}"
                })
            else:
                self.log("✗ Buffer statistics incomplete", "WARNING")
                self.test_results.append({
                    "test": test_name,
                    "passed": True,  # Not a failure, just no data yet
                    "message": "Buffer stats available (may be empty)"
                })
                
        except Exception as e:
            self.log(f"✗ Buffer monitoring test failed: {e}", "ERROR")
            self.test_results.append({
                "test": test_name,
                "passed": False,
                "message": str(e)
            })
            
    def _test_trade_reading(self):
        """Test 3: Verify trade reading works."""
        self.log("\n--- Test 3: Trade Reading ---")
        test_name = "trade_reading"
        
        if self.reader is None:
            self.reader = create_reader()
            
        if self.reader is None:
            self.log("✗ No reader available for trade reading", "ERROR")
            self.test_results.append({
                "test": test_name,
                "passed": False,
                "message": "No reader available"
            })
            return
            
        trades_received = []
        start_time = time.time()
        
        # Callback for receiving trades
        def on_trade(trade: Trade):
            trades_received.append(trade)
            self.log(f"  Received trade: {trade.exchange}:{trade.symbol} @ {trade.price}")
            
        # Subscribe to trades
        subscription_id = self.reader.subscribe_trades(on_trade)
        self.log(f"Subscribed to trades (id: {subscription_id})")
        
        # Wait for data or timeout
        self.log(f"Waiting for trades (timeout: {self.timeout_seconds}s)...")
        while time.time() - start_time < self.timeout_seconds and not self.stop_event.is_set():
            time.sleep(0.5)
            
        # Unsubscribe
        self.reader.unsubscribe(subscription_id)
        
        elapsed = time.time() - start_time
        self.log(f"Received {len(trades_received)} trades in {elapsed:.2f}s")
        
        if trades_received:
            # Validate trade structure
            for trade in trades_received[:5]:  # Check first 5
                valid = (
                    hasattr(trade, 'exchange') and trade.exchange and
                    hasattr(trade, 'symbol') and trade.symbol and
                    hasattr(trade, 'price') and trade.price > 0 and
                    hasattr(trade, 'quantity') and trade.quantity > 0 and
                    hasattr(trade, 'timestamp_us') and trade.timestamp_us > 0
                )
                if not valid:
                    self.log(f"✗ Invalid trade structure: {trade}", "ERROR")
                    self.test_results.append({
                        "test": test_name,
                        "passed": False,
                        "message": f"Invalid trade structure"
                    })
                    return
                    
            self.log(f"✓ Received {len(trades_received)} valid trades")
            self.test_results.append({
                "test": test_name,
                "passed": True,
                "message": f"Received {len(trades_received)} trades"
            })
        else:
            self.log("✗ No trades received (collector may not be running)", "WARNING")
            self.test_results.append({
                "test": test_name,
                "passed": False,
                "message": "No trades received"
            })
            
    def _test_orderbook_reading(self):
