                )
                if not valid:
                    self.log(f"✗ Invalid orderbook structure", "ERROR")
                    self.test_results.append({
                        "test": test_name,
                        "passed": False,
                        "message": f"Invalid orderbook structure"
                    })
                    return
                    
            self.log(f"✓ Received {len(snapshots_received)} valid orderbooks")
            self.test_results.append({
                "test": test_name,
                "passed": True,
                "message": f"Received {len(snapshots_received)} orderbooks"
            })
        else:
            self.log("✗ No orderbooks received (collector may not be running)", "WARNING")
            self.test_results.append({
                "test": test_name,
                "passed": False,
                "message": "No orderbooks received"
            })
            
    def _test_health_monitoring(self):
